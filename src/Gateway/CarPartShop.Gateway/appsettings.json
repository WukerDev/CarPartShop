{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "keycloak-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "grpc-catalog-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/carpartshop.catalog.CatalogService/{**catch-all}"
        }
      },
      "grpc-order-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/carpartshop.orders.OrderService/{**catch-all}"
        }
      },
      "grpc-payment-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/carpartshop.payment.PaymentService/{**catch-all}"
        }
      },
      "portal-route": {
        "ClusterId": "frontend-cluster",
        "Match": {
          "Path": "/portal/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal" }
        ]
      },
      "frontend-root-route": {
        "ClusterId": "frontend-cluster",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "keycloak-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://keycloak:8080"
          }
        }
      },
      "backend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://backend:5001"
          }
        }
      },
      "frontend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://frontend:80"
          }
        }
      }
    }
  }
}
